{
  "name": "openchamber-wakatime",
  "version": "1.0.0",
  "private": true,
  "description": "WakaTime status panel for OpenChamber. Shows today's coding time, a daily chart, language and project rankings, editors, and AI usage.",
  "license": "MIT",
  "author": "Howon Lee (airtaxi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airtaxi/openchamber-wakatime.git"
  },
  "homepage": "https://github.com/airtaxi/openchamber-wakatime#readme",
  "bugs": {
    "url": "https://github.com/airtaxi/openchamber-wakatime/issues"
  },
  "type": "module",
  "scripts": {
    "bundle:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "bundle:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "build": "bun run bundle:panel && bun run bundle:service",
    "typecheck": "tsc --noEmit"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "wakatime",
        "name": "WakaTime",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
